<Project Sdk="Microsoft.NET.Sdk">

  <!--
    非侵入性の設計点検（仕様書 19.2、A11、T17）。配布する組立品のメタデータを読み、
    ネイティブ関数の呼出し、入力生成、他プロセスへの接続、外部送信先が承認した範囲だけであることを確かめる。
    アプリを参照して、配布物と同じ依存物を出力フォルダーへ集める。
  -->
  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\D2Translator.App\D2Translator.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
