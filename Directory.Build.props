<Project>
  <PropertyGroup>
    <!-- 仕様書 6.1: Windows API を使うプロジェクトの TFM。Windows 10 対応を宣言するものではない -->
    <WindowsTargetFramework>net10.0-windows10.0.19041.0</WindowsTargetFramework>
    <PortableTargetFramework>net10.0</PortableTargetFramework>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 自己完結型の発行（-r win-x64）でも全プロジェクトの復元ロックが変わらないよう RID をそろえる -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>

    <!-- 仕様書 17.3: 復元ロックで依存物の版を固定する -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>

    <Product>D2 Chat Translator</Product>
    <!-- 版の唯一の定義。MSIX の版（4 桁）は scripts/package-msix.ps1 がここから作る -->
    <Version>0.1.2</Version>
  </PropertyGroup>
</Project>
