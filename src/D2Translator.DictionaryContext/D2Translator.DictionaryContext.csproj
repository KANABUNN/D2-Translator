<Project Sdk="Microsoft.NET.Sdk">

  <!-- 仕様書 5.2 Dictionary Context: 辞書照合、活動別語義、用語保護。外部依存なし -->
  <PropertyGroup>
    <TargetFramework>$(PortableTargetFramework)</TargetFramework>
    <RootNamespace>D2Translator.DictionaryContext</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 出典と検証結果は docs/glossary に別に置き、辞書には埋め込まない -->
    <EmbeddedResource Include="Data\glossary-default.json" LogicalName="glossary-default.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- 索引による絞り込みと全件照合の結果の一致を試験する -->
    <InternalsVisibleTo Include="D2Translator.DictionaryContext.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D2Translator.Domain\D2Translator.Domain.csproj" />
    <ProjectReference Include="..\D2Translator.TextTracking\D2Translator.TextTracking.csproj" />
  </ItemGroup>

</Project>
