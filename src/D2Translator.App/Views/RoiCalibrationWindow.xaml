<Window x:Class="D2Translator.App.Views.RoiCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:D2Translator.App.ViewModels"
        xmlns:p="clr-namespace:D2Translator.App.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RoiCalibrationViewModel}"
        Title="ROI 調整"
        Width="1100" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" BorderThickness="1"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            Background="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}">
      <!-- 内側の Grid は取得画像のピクセル寸法。マウス座標がそのまま画像ピクセルになる -->
      <Viewbox Stretch="Uniform">
        <Grid x:Name="Surface"
              Width="{Binding FrameWidth}" Height="{Binding FrameHeight}"
              Background="Transparent" Cursor="Cross"
              MouseLeftButtonDown="Surface_MouseLeftButtonDown"
              MouseMove="Surface_MouseMove"
              MouseLeftButtonUp="Surface_MouseLeftButtonUp"
              AutomationProperties.Name="取得画像のプレビュー">
          <Image Source="{Binding Preview}" Stretch="Fill" />
          <Canvas>
            <Rectangle x:Name="SelectionBox" Visibility="Collapsed" Fill="#3300A0FF" Stroke="#FF00A0FF" />
          </Canvas>
        </Grid>
      </Viewbox>
    </Border>

    <DockPanel Grid.Column="2">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding TargetName, StringFormat=対象: {0}}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,12" p:LiveRegion.Setting="Polite" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="プレビュー上でチャット欄をドラッグして囲むか、下の数値で指定してください。チャットが消える前に「プレビューを止める」で静止できます。" />
        <CheckBox Content="プレビューを止める(_F)" IsChecked="{Binding IsPreviewFrozen}" Margin="0,0,0,12" />
        <TextBlock Style="{StaticResource StatusLabel}" Text="選択中の領域" />
        <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" Margin="0,0,0,8" p:LiveRegion.Setting="Polite" />
        <!-- マウスを使わずに指定する（取得画像のピクセル） -->
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Label Grid.Row="0" Grid.Column="0" Content="左(_X)" Target="{Binding ElementName=RoiLeftBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
          <TextBox x:Name="RoiLeftBox" Grid.Row="0" Grid.Column="1" Text="{Binding RoiLeft}" Margin="0,0,8,4" AutomationProperties.Name="ROI の左端（ピクセル）" />
          <Label Grid.Row="0" Grid.Column="2" Content="上(_Y)" Target="{Binding ElementName=RoiTopBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
          <TextBox x:Name="RoiTopBox" Grid.Row="0" Grid.Column="3" Text="{Binding RoiTop}" Margin="0,0,0,4" AutomationProperties.Name="ROI の上端（ピクセル）" />
          <Label Grid.Row="1" Grid.Column="0" Content="幅(_W)" Target="{Binding ElementName=RoiWidthBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
          <TextBox x:Name="RoiWidthBox" Grid.Row="1" Grid.Column="1" Text="{Binding RoiWidth}" Margin="0,0,8,0" AutomationProperties.Name="ROI の幅（ピクセル）" />
          <Label Grid.Row="1" Grid.Column="2" Content="高さ(_H)" Target="{Binding ElementName=RoiHeightBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
          <TextBox x:Name="RoiHeightBox" Grid.Row="1" Grid.Column="3" Text="{Binding RoiHeight}" AutomationProperties.Name="ROI の高さ（ピクセル）" />
        </Grid>
        <WrapPanel Margin="0,0,0,8">
          <Button Content="数値で設定(_N)" Command="{Binding ApplyNumbersCommand}" Margin="0,0,8,4" />
          <Button Content="試し読み(_T)" Command="{Binding TestReadCommand}" Margin="0,0,0,4" />
        </WrapPanel>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="保存(_S)" Command="{Binding SaveCommand}" IsDefault="True" />
        <Button Content="取消" Command="{Binding CancelCommand}" IsCancel="True" Margin="0" />
      </StackPanel>

      <TextBox Text="{Binding TestResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" AutomationProperties.Name="試し読みの結果" />
    </DockPanel>
  </Grid>
</Window>
