<UserControl x:Class="D2Translator.App.Views.TranslationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:D2Translator.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TranslationSettingsViewModel}">
  <!-- 翻訳の設定は送信内容の確認と認証情報を伴うため、操作した時点で反映する -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="使用 AI（変更できません）" />
        <TextBlock Text="{Binding FixedProfile}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="外部へ送信する内容" />
        <TextBlock Text="{Binding DataNotice}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <CheckBox Content="上記の内容を確認しました" IsChecked="{Binding ConsentGiven}" Margin="0,0,0,8" />
        <CheckBox Content="クラウド翻訳を有効にする" IsChecked="{Binding CloudEnabled}" IsEnabled="{Binding CanEnableCloud}" Margin="0,0,0,4" />
        <CheckBox Content="直近の会話を文脈として送る（最大 6 件、120 秒、1500 文字）" IsChecked="{Binding ContextEnabled}" Margin="0,0,0,16" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="OpenAI の API キー" />
        <WrapPanel Margin="0,0,0,6">
          <TextBlock Style="{StaticResource StatusLabel}" Text="状態:" />
          <TextBlock Style="{StaticResource StatusValue}" Text="{Binding KeyStatus}" />
        </WrapPanel>
        <DockPanel Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Content="登録・差し替え" Click="SaveKey_Click" Margin="8,0,0,0" />
          <PasswordBox x:Name="KeyBox" AutomationProperties.Name="API キー" VerticalContentAlignment="Center" />
        </DockPanel>
        <Button Content="API キーを削除" Command="{Binding DeleteKeyCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="接続確認" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource StatusLabel}"
                   Text="短い英文を 1 回だけ翻訳して、API キー、gpt-6-luna の利用可否、応答形式を確かめます。1 回分の API 利用料が生じ得ます。" />
        <Button Content="接続確認" Command="{Binding TestConnectionCommand}" HorizontalAlignment="Left" Margin="0,0,0,6" />
        <TextBox Text="{Binding TestResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48"
                 AutomationProperties.Name="接続確認の結果" Margin="0,0,0,12" />

        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" />
      </StackPanel>
    </ScrollViewer>
</UserControl>