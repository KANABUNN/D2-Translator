<Window x:Class="D2Translator.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:D2Translator.App.ViewModels"
        xmlns:p="clr-namespace:D2Translator.App.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="D2 Chat Translator"
        Width="960" Height="720" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 対象、取得、OpenAI、使用AI、表示方式を別々に表示する（仕様書 11.2） -->
    <WrapPanel Grid.Row="0" Margin="0,0,0,12" AutomationProperties.Name="状態">
      <TextBlock Style="{StaticResource StatusLabel}" Text="対象:" />
      <TextBlock Style="{StaticResource StatusValue}" Text="{Binding TargetName}" />
      <TextBlock Style="{StaticResource StatusLabel}" Text="取得:" />
      <TextBlock Style="{StaticResource StatusValue}" Text="{Binding CaptureStateText}" />
      <TextBlock Style="{StaticResource StatusLabel}" Text="クラウド翻訳:" />
      <TextBlock Style="{StaticResource StatusValue}" Text="{Binding CloudStatusText}" />
      <TextBlock Style="{StaticResource StatusLabel}" Text="使用AI:" />
      <TextBlock Style="{StaticResource StatusValue}" Text="{Binding ModelText}" />
      <TextBlock Style="{StaticResource StatusLabel}" Text="表示方式:" />
      <TextBlock Style="{StaticResource StatusValue}" Text="{Binding DisplayModeText}" />
    </WrapPanel>

    <!-- 主要操作はキーボードだけでも使えるよう、アクセスキー（Alt + 文字）を付ける（仕様書 17.2） -->
    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
      <Button Content="対象を選択(_T)…" Command="{Binding SelectTargetCommand}" Margin="0,0,8,4" />
      <Button Content="ROI 調整(_R)…" Command="{Binding CalibrateCommand}" Margin="0,0,8,4" />
      <Button Content="開始(_S)" Command="{Binding StartCommand}" Margin="0,0,8,4" />
      <Button Content="停止(_P)" Command="{Binding StopCommand}" Margin="0,0,16,4" />
      <Button Content="返信(_J)…" Command="{Binding OpenReplyCommand}" Margin="0,0,8,4" />
      <Button Content="表示切替(_O)" Command="{Binding ToggleDisplayModeCommand}" Margin="0,0,8,4"
              ToolTip="独立ウィンドウとオーバーレイを切り替えます（Ctrl+Alt+O）" />
      <Button Content="オーバーレイ配置(_L)…" Command="{Binding BeginPlacementEditCommand}" Margin="0,0,8,4"
              ToolTip="オーバーレイをドラッグで移動します。Esc か、もう一度押すと終了します" />
      <Button Content="設定(_E)…" Command="{Binding OpenSettingsCommand}" Margin="0,0,8,4" />
      <TextBlock Text="{Binding WaitingText}" VerticalAlignment="Center" FontWeight="SemiBold"
                 p:LiveRegion.Setting="Polite" />
    </WrapPanel>

    <Border Grid.Row="2" Margin="0,0,0,12" Padding="10,8" BorderThickness="1"
            BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Notice}" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.Name="通知" p:LiveRegion.Setting="Assertive" />
    </Border>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="受信履歴" />
        <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource StatusLabel}"
                   Text="他プレイヤーの発言は、クラウド翻訳が有効なら GPT-6 Luna で日本語に翻訳します。参加通知などのシステム表示と自分の発言は翻訳せず、システム表示は履歴にも表示しません。" />
        <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" AutomationProperties.Name="受信履歴"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource StatusLabel}" Margin="0,2,10,0" />
                <StackPanel Grid.Column="1">
                  <WrapPanel>
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusLabel}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" />
                  <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasTranslation}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding TranslationNote}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                             Style="{StaticResource StatusLabel}">
                  </TextBlock>
                  <Button Content="翻訳" HorizontalAlignment="Left" Padding="8,1" MinWidth="0" Margin="0,4,0,0"
                          Command="{Binding DataContext.TranslateMessageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                          CommandParameter="{Binding MessageId}"
                          ToolTip="この発言を GPT-6 Luna で翻訳します（API 利用料が生じ得ます）">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CanTranslate}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <TextBlock Text="{Binding Annotations}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                             Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasAnnotations}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionHeader}" Text="診断" />
          <TextBlock Text="{Binding StatsText}" TextWrapping="Wrap" Margin="0,0,0,4" />
          <TextBlock Text="{Binding HiddenText}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <TextBlock Style="{StaticResource StatusLabel}" Text="翻訳の利用量（この実行中）" />
          <TextBlock Text="{Binding UsageText}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <TextBlock Style="{StaticResource StatusLabel}" Text="最新の観測（組み立てた行）" />
          <TextBlock Text="{Binding LastObservationText}" TextWrapping="Wrap" FontSize="11" Style="{StaticResource StatusLabel}" />
          <ItemsControl ItemsSource="{Binding Lines}" Margin="0,2,0,12" AutomationProperties.Name="最新の観測">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource StatusLabel}" Text="ホットキー" />
          <TextBlock Text="{Binding HotkeyStatusText}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock Style="{StaticResource StatusLabel}" Text="オーバーレイの映り込み除外" />
          <TextBlock Text="{Binding CaptureExclusionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock Style="{StaticResource StatusLabel}" Text="D2 辞書" />
          <TextBlock Text="{Binding GlossaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock Style="{StaticResource StatusLabel}" Text="OCR" />
          <TextBlock Text="{Binding OcrText}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock Style="{StaticResource StatusLabel}" Text="版" />
          <TextBlock Text="{Binding VersionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock Style="{StaticResource StatusLabel}" Text="パッケージ識別情報" />
          <TextBlock Text="{Binding PackageText}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock Style="{StaticResource StatusLabel}" Text="保存先" />
          <TextBox Text="{Binding DataFolder, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                   BorderThickness="0" Background="Transparent" AutomationProperties.Name="保存先" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <TextBlock Grid.Row="4" Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource StatusLabel}"
               Text="画面の取得は Windows の機能だけを使い、ゲームへの入力や介入は行いません。これはアンチチートによる許可やアカウントの安全を保証するものではありません。" />
  </Grid>
</Window>
