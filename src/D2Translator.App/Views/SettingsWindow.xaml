<Window x:Class="D2Translator.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:D2Translator.App.ViewModels"
        xmlns:views="clr-namespace:D2Translator.App.Views"
        xmlns:p="clr-namespace:D2Translator.App.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="設定"
        Width="760" Height="720" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
  <Window.Resources>
    <vm:SendStyleLabelConverter x:Key="StyleLabel" />
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Width" Value="220" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Resources>
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="既定値に戻す(_D)" Command="{Binding RestoreDefaultsCommand}" />
        <Button Content="適用(_A)" Command="{Binding ApplyCommand}" IsDefault="True" />
        <Button Content="閉じる" IsCancel="True" Margin="0" />
      </StackPanel>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                 p:LiveRegion.Setting="Polite" />
    </DockPanel>

    <TabControl>
      <TabItem Header="表示">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <DockPanel Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Caption}" Text="表示方式" />
              <StackPanel Orientation="Horizontal">
                <RadioButton Content="独立ウィンドウ" IsChecked="{Binding OverlayMode, Converter={x:Static vm:InverseBooleanConverter.Instance}}" Margin="0,0,16,0" />
                <RadioButton Content="オーバーレイ" IsChecked="{Binding OverlayMode}" />
              </StackPanel>
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Caption}" Text="{Binding Opacity, StringFormat=オーバーレイの背景の不透明度 {0:P0}}" />
              <Slider Minimum="0.2" Maximum="0.95" Value="{Binding Opacity}" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="不透明度" />
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Caption}" Text="{Binding FontSize, StringFormat=文字の大きさ {0:0} DIP}" />
              <Slider Minimum="14" Maximum="32" Value="{Binding FontSize}" SmallChange="1" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="文字の大きさ" />
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Caption}" Text="{Binding OverlayWidth, StringFormat=オーバーレイの幅 {0:0} DIP}" />
              <Slider Minimum="280" Maximum="1200" Value="{Binding OverlayWidth}" SmallChange="10" LargeChange="50" AutomationProperties.Name="オーバーレイの幅" />
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
              <TextBlock Style="{StaticResource Caption}" Text="{Binding MaxMessages, StringFormat=オーバーレイに出す件数 {0}}" />
              <Slider Minimum="1" Maximum="10" Value="{Binding MaxMessages}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="表示件数" />
            </DockPanel>
            <CheckBox Content="ゲームが前面でない時はオーバーレイを隠す" IsChecked="{Binding HideWhenGameInactive}" Margin="0,0,0,8" />
            <CheckBox Content="オーバーレイを表示できない時は自動で独立ウィンドウに戻す" IsChecked="{Binding AutoFallback}" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource StatusLabel}"
                       Text="オーバーレイはゲームの描画に参加しない別のウィンドウです。排他フルスクリーンでは表示できないため、ボーダーレスかウィンドウ表示にしてください。表示中はクリックをゲームへ通し、配置編集の間だけ操作を受け付けます。" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="取得と OCR">
        <StackPanel Margin="12">
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Caption}" Text="{Binding OcrRate, StringFormat=OCR の頻度 毎秒 {0:0} 回}" />
            <Slider Minimum="2" Maximum="10" Value="{Binding OcrRate}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="OCR の頻度" />
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Caption}" Text="本文の言語" />
            <TextBox Text="{Binding OcrLanguage}" AutomationProperties.Name="本文の言語" />
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Caption}" Text="ゲームの表示言語（空欄で本文の言語だけ）" />
            <TextBox Text="{Binding ClientLanguage}" AutomationProperties.Name="ゲームの表示言語" />
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Caption}" Text="{Binding OcrScale, StringFormat=OCR 前の拡大 {0} 倍}" />
            <Slider Minimum="1" Maximum="3" Value="{Binding OcrScale}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="拡大倍率" />
          </DockPanel>
          <TextBlock TextWrapping="Wrap" Style="{StaticResource StatusLabel}"
                     Text="OCR の頻度は次に「開始」した時から、言語と拡大倍率は次回起動時から反映します。取得対象と ROI はメイン画面で選び直します。" />
        </StackPanel>
      </TabItem>

      <TabItem Header="翻訳">
        <views:TranslationSettingsView DataContext="{Binding Translation}" Margin="12" />
      </TabItem>

      <TabItem Header="返信とクリップボード">
        <StackPanel Margin="12">
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Caption}" Text="返信の既定の文体" />
            <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding Style}" AutomationProperties.Name="既定の文体">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource StyleLabel}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>
          <CheckBox Content="コピーした英訳をクリップボードから自動で消去する" IsChecked="{Binding ClipboardAutoClear}" Margin="0,0,0,8" />
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Caption}" Text="{Binding ClipboardSeconds, StringFormat=消去までの秒数 {0}}" />
            <Slider Minimum="5" Maximum="600" Value="{Binding ClipboardSeconds}" SmallChange="5" LargeChange="30" IsSnapToTickEnabled="True" TickFrequency="5" AutomationProperties.Name="消去までの秒数" />
          </DockPanel>
          <TextBlock TextWrapping="Wrap" Style="{StaticResource StatusLabel}"
                     Text="自動消去は、コピーの後にクリップボードの内容が変わっていない場合だけ行います。Windows のクリップボード履歴、クラウド同期、他のアプリが既に取得したコピーまでは削除できません。クリップボードの監視や他のアプリの内容の読み取りは行いません。" />
        </StackPanel>
      </TabItem>

      <TabItem Header="ホットキー">
        <StackPanel Margin="12">
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Caption}" Text="取得と翻訳の一時停止・再開" />
            <TextBox Text="{Binding TogglePause}" AutomationProperties.Name="一時停止のホットキー" />
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Caption}" Text="表示方式の切替" />
            <TextBox Text="{Binding ToggleDisplayMode}" AutomationProperties.Name="表示方式の切替のホットキー" />
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Caption}" Text="オーバーレイを隠す・表示" />
            <TextBox Text="{Binding ToggleOverlayVisibility}" AutomationProperties.Name="オーバーレイの表示のホットキー" />
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource Caption}" Text="返信画面を開く" />
            <TextBox Text="{Binding OpenReply}" AutomationProperties.Name="返信画面のホットキー" />
          </DockPanel>
          <TextBlock TextWrapping="Wrap" Style="{StaticResource StatusLabel}" Margin="0,0,0,8"
                     Text="例: Ctrl+Alt+T。修飾キー（Ctrl、Alt、Shift、Win）を 1 つ以上含めます。空欄で無効。他のアプリと競合すると登録されず、その操作はメイン画面のボタンで行います。" />
          <TextBlock Style="{StaticResource SectionHeader}" Text="登録の状態" />
          <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
